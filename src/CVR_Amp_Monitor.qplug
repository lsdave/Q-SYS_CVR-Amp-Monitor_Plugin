--[[
  CVR Amp Monitor — Q-SYS plugin
  An Atem Audio project — https://atem.audio

  Read-only live metering + channel status for CVR Pro Audio DSP amplifiers
  (firmware 1.1.8 / 1.1.9, 4-channel "WHOLE118" heartbeat family).

  Protocol ported from OpenAmpCore/ampcore (crates/ampcore-core/src/live/cvr):
    - UDP, amp listens on 45455, controller listens on 45454
    - FC=0  BASIC_INFO  -> firmware string, name, MAC, channel counts
    - FC=6  HEARTBEAT   -> temps, output V/A, output states, input V,
                           limiter gain reduction, input clip flags
    - Every inbound data datagram is ACK'd by echoing its 10-byte network
      header with data_state = 1.

  No discovery: enter the amp's IP address and press Connect.
  Nothing is ever written to the amp other than queries and ACKs.

  v1.1.2 (UNTESTED BETA): GR meters are empty until the limiter actually reduces gain (Standard
  meter, 0..24 dB, grows up from the bottom).
  v1.1.1: rebranded to Atem Audio (plugin Id unchanged, existing designs keep working).
  v1.1.0: meters are now drawn by a separate render timer with attack/release
  ballistics, so they glide between heartbeat samples instead of stepping.
  Default poll interval lowered to 50 ms.
]]

PluginInfo = {
  Name = "Atem Audio~CVR Amp Monitor",
  Version = "1.1.2",
  BuildVersion = "1.1.2.1",
  Id = "6b0e2c1a-4f7d-4c39-9a8e-2d5f1b7c3e90",
  Author = "Atem Audio",
  Description = "Input/output metering, limiter gain reduction and channel status for CVR DSP amplifiers (fw 1.1.8/1.1.9) over UDP."
}

local NCH = 4
local OUT_LETTERS = { "A", "B", "C", "D" }

-- Rated RMS output voltage per model (0 dB on the output meters).
-- From ampcore's RATED_RMS_VOLTAGE_TABLE. Dante "D" variants share ratings.
local MODEL_TABLE = {
  { "DSP-654", 72.1 },  { "DSP-802", 80.0 },   { "DSP-1002", 89.4 },
  { "DSP-1004", 89.4 }, { "DSP-1502", 109.5 }, { "DSP-1504", 109.5 },
  { "DSP-2002", 126.5 },{ "DSP-2004", 126.5 }, { "DSP-3002", 154.9 },
  { "DSP-3004", 154.9 },{ "DSP-3302", 162.5 }, { "DSP-4302", 185.5 },
}

local MODEL_CHOICES = { "Auto (from firmware)" }
for _, m in ipairs(MODEL_TABLE) do table.insert(MODEL_CHOICES, m[1]) end
table.insert(MODEL_CHOICES, "Custom")

function GetColor(props)
  return { 40, 44, 52 }
end

function GetPrettyName(props)
  return "CVR Amp Monitor " .. PluginInfo.Version .. " (untested)"
end

local PageNames = { "Amp", "Diagnostics" }
function GetPages(props)
  local pages = {}
  for _, n in ipairs(PageNames) do table.insert(pages, { name = n }) end
  return pages
end

function GetProperties()
  return {
    { Name = "Amp Model", Type = "enum", Choices = MODEL_CHOICES, Value = MODEL_CHOICES[1] },
    { Name = "Custom Rated Vrms", Type = "integer", Min = 10, Max = 400, Value = 100 },
    { Name = "Poll Interval (ms)", Type = "integer", Min = 20, Max = 1000, Value = 50 },
    { Name = "Meter Refresh (ms)", Type = "integer", Min = 15, Max = 200, Value = 30 },
    { Name = "Meter Attack (ms)", Type = "integer", Min = 0, Max = 500, Value = 40 },
    { Name = "Meter Release (ms)", Type = "integer", Min = 0, Max = 3000, Value = 250 },
    { Name = "Indicator Hold (ms)", Type = "integer", Min = 0, Max = 5000, Value = 750 },
    { Name = "Limit LED Threshold (dB GR)", Type = "integer", Min = 0, Max = 6, Value = 1 },
    { Name = "Offline Timeout (s)", Type = "integer", Min = 1, Max = 30, Value = 3 },
    { Name = "Listen Port", Type = "enum", Choices = { "45454 (CVR default)", "Auto (ephemeral)" }, Value = "45454 (CVR default)" },
    { Name = "Debug Print", Type = "boolean", Value = false },
  }
end

function RectifyProperties(props)
  props["Custom Rated Vrms"].IsHidden = props["Amp Model"].Value ~= "Custom"
  local smoothing = props["Meter Attack (ms)"].Value > 0 or props["Meter Release (ms)"].Value > 0
  props["Meter Refresh (ms)"].IsHidden = not smoothing
  return props
end

function GetControls(props)
  local c = {}
  local function add(t) table.insert(c, t) end

  -- Connection / amp-level
  add({ Name = "IPAddress", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Input" })
  add({ Name = "Connect", ControlType = "Button", ButtonType = "Toggle", Count = 1, UserPin = true, PinStyle = "Both" })
  add({ Name = "Status", ControlType = "Indicator", IndicatorType = "Status", Count = 1, UserPin = true, PinStyle = "Output" })
  add({ Name = "Online", ControlType = "Indicator", IndicatorType = "Led", Count = 1, UserPin = true, PinStyle = "Output" })
  for _, n in ipairs({ "Model", "DeviceName", "Firmware", "MAC", "AmpState", "PSUTemp", "FanVolts" }) do
    add({ Name = n, ControlType = "Indicator", IndicatorType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  end

  -- Inputs
  add({ Name = "InLevel", ControlType = "Indicator", IndicatorType = "Meter", Count = NCH, Min = -60, Max = 20, UserPin = true, PinStyle = "Output" })
  add({ Name = "InLevelText", ControlType = "Indicator", IndicatorType = "Text", Count = NCH, UserPin = true, PinStyle = "Output" })
  add({ Name = "InVolts", ControlType = "Indicator", IndicatorType = "Text", Count = NCH, UserPin = true, PinStyle = "Output" })
  add({ Name = "InClip", ControlType = "Indicator", IndicatorType = "Led", Count = NCH, UserPin = true, PinStyle = "Output" })

  -- Outputs
  add({ Name = "OutLevel", ControlType = "Indicator", IndicatorType = "Meter", Count = NCH, Min = -60, Max = 3, UserPin = true, PinStyle = "Output" })
  add({ Name = "GainReduction", ControlType = "Indicator", IndicatorType = "Meter", Count = NCH, Min = 0, Max = 24, UserPin = true, PinStyle = "Output" })
  for _, n in ipairs({ "OutLevelText", "GRText", "OutVolts", "OutAmps", "OutOhms", "OutTemp", "ChState" }) do
    add({ Name = n, ControlType = "Indicator", IndicatorType = "Text", Count = NCH, UserPin = true, PinStyle = "Output" })
  end
  for _, n in ipairs({ "Limit", "Clip", "Fault", "TempWarn" }) do
    add({ Name = n, ControlType = "Indicator", IndicatorType = "Led", Count = NCH, UserPin = true, PinStyle = "Output" })
  end

  -- Diagnostics
  for _, n in ipairs({ "RxCount", "TxCount", "BadFrames", "BodyLength", "HeartbeatLayout", "RawOutStates", "RawInStates", "RawMachineMode", "LocalPort", "RawHex", "HBRate" }) do
    add({ Name = n, ControlType = "Indicator", IndicatorType = "Text", Count = 1, UserPin = false, PinStyle = "None" })
  end
  return c
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local page = PageNames[props["page_index"].Value]

  local WHITE, DIM = { 230, 230, 230 }, { 160, 160, 160 }
  local BOX_FILL = { 52, 57, 66 }
  local RED, YELLOW, ORANGE, GREEN = { 255, 40, 40 }, { 255, 210, 0 }, { 255, 130, 0 }, { 0, 220, 80 }

  local function box(text, x, y, w, h)
    table.insert(graphics, { Type = "GroupBox", Text = text, Fill = BOX_FILL, StrokeColor = { 90, 96, 108 }, StrokeWidth = 1, CornerRadius = 6, Color = WHITE, HTextAlign = "Left", FontSize = 12, Position = { x, y }, Size = { w, h } })
  end
  local function label(text, x, y, w, h, align, size, color)
    table.insert(graphics, { Type = "Text", Text = text, Position = { x, y }, Size = { w, h }, FontSize = size or 10, HTextAlign = align or "Right", Color = color or DIM })
  end
  local function text(name, pretty, x, y, w, h)
    layout[name] = { PrettyName = pretty, Style = "Text", Position = { x, y }, Size = { w, h }, FontSize = 10, HTextAlign = "Center" }
  end
  local function led(name, pretty, color, x, y)
    layout[name] = { PrettyName = pretty, Style = "Led", Color = color, UnlinkOffColor = true, OffColor = { 45, 45, 45 }, Position = { x, y }, Size = { 16, 16 }, Margin = 2 }
  end
  local function meter(name, pretty, style, x, y, w, h, color)
    layout[name] = { PrettyName = pretty, Style = "Meter", MeterStyle = style, Color = color, ShowTextbox = false, Position = { x, y }, Size = { w, h } }
  end

  if page == "Amp" then
    local W = 440
    -- Connection
    box("Connection", 10, 5, W, 118)
    label("IP Address", 15, 25, 62, 18)
    text("IPAddress", "Connection~IP Address", 80, 25, 120, 18)
    layout["Connect"] = { PrettyName = "Connection~Connect", Style = "Button", ButtonStyle = "Toggle", Legend = "Connect", Color = GREEN, Position = { 206, 25 }, Size = { 64, 18 } }
    led("Online", "Connection~Online", GREEN, 276, 26)
    layout["Status"] = { PrettyName = "Connection~Status", Style = "Text", Position = { 296, 25 }, Size = { 148, 18 }, FontSize = 9 }

    local rows = {
      { "Model", "Model", "DeviceName", "Name" },
      { "Firmware", "Firmware", "MAC", "MAC" },
      { "AmpState", "Amp State", "PSUTemp", "PSU Temp" },
    }
    for r, row in ipairs(rows) do
      local y = 25 + r * 23
      label(row[2], 15, y, 62, 18); text(row[1], "Amp~" .. row[2], 80, y, 145, 18)
      label(row[4], 230, y, 62, 18); text(row[3], "Amp~" .. row[4], 296, y, 148, 18)
    end

    -- Inputs
    local CW = 105
    box("Inputs (dBV)", 10, 128, W, 235)
    for i = 1, NCH do
      local cx = 15 + (i - 1) * CW
      label("In " .. i, cx, 146, CW - 5, 16, "Center", 11, WHITE)
      meter("InLevel " .. i, "Input " .. i .. "~Level", "Level", cx + 34, 164, 32, 132)
      text("InLevelText " .. i, "Input " .. i .. "~Level Text", cx + 5, 300, CW - 15, 16)
      text("InVolts " .. i, "Input " .. i .. "~Volts", cx + 5, 318, CW - 15, 16)
      led("InClip " .. i, "Input " .. i .. "~Clip", RED, cx + 28, 339)
      label("Clip", cx + 46, 339, 30, 16, "Left")
    end

    -- Outputs
    box("Outputs (dB re rated Vrms)", 10, 368, W, 372)
    for i = 1, NCH do
      local cx = 15 + (i - 1) * CW
      local ch = OUT_LETTERS[i]
      label("Out " .. ch, cx, 386, CW - 5, 16, "Center", 11, WHITE)
      meter("OutLevel " .. i, "Output " .. ch .. "~Level", "Level", cx + 16, 404, 30, 130)
      meter("GainReduction " .. i, "Output " .. ch .. "~Gain Reduction", "Standard", cx + 54, 404, 30, 130, ORANGE)
      label("Lvl", cx + 16, 536, 30, 12, "Center", 9)
      label("GR", cx + 54, 536, 30, 12, "Center", 9)
      text("OutLevelText " .. i, "Output " .. ch .. "~Level Text", cx + 5, 550, CW - 15, 16)
      text("GRText " .. i, "Output " .. ch .. "~GR Text", cx + 5, 568, CW - 15, 16)

      led("Limit " .. i, "Output " .. ch .. "~Limit", YELLOW, cx + 6, 590);    label("Lim", cx + 23, 590, 24, 16, "Left")
      led("Clip " .. i, "Output " .. ch .. "~Clip", RED, cx + 52, 590);        label("Clip", cx + 69, 590, 26, 16, "Left")
      led("Fault " .. i, "Output " .. ch .. "~Fault", RED, cx + 6, 610);       label("Flt", cx + 23, 610, 24, 16, "Left")
      led("TempWarn " .. i, "Output " .. ch .. "~Temp", ORANGE, cx + 52, 610); label("Tmp", cx + 69, 610, 26, 16, "Left")

      text("ChState " .. i, "Output " .. ch .. "~State", cx + 5, 632, CW - 15, 18)
      local rr = { { "OutVolts", "V" }, { "OutAmps", "A" }, { "OutOhms", "Ω" }, { "OutTemp", "°C" } }
      for k, r in ipairs(rr) do
        local y = 654 + (k - 1) * 19
        label(r[2], cx, y, 18, 16)
        text(r[1] .. " " .. i, "Output " .. ch .. "~" .. r[1], cx + 21, y, CW - 31, 16)
      end
    end
    label("Atem Audio · CVR Amp Monitor v" .. PluginInfo.Version .. " · UNTESTED BETA", 10, 744, W, 14, "Center", 9)

  elseif page == "Diagnostics" then
    box("Diagnostics", 10, 5, 440, 374)
    local items = {
      { "RxCount", "Rx packets" }, { "TxCount", "Tx packets" }, { "HBRate", "Heartbeat rate" },
      { "BadFrames", "Bad frames" }, { "BodyLength", "HB body length" }, { "HeartbeatLayout", "HB layout" },
      { "RawOutStates", "Raw out states" }, { "RawInStates", "Raw in states" }, { "RawMachineMode", "Machine mode" },
      { "LocalPort", "Local port" }, { "FanVolts", "Fan voltage" },
    }
    for k, it in ipairs(items) do
      local y = 25 + (k - 1) * 22
      label(it[2], 15, y, 110, 18)
      text(it[1], "Diagnostics~" .. it[2], 130, y, 310, 18)
    end
    label("Last heartbeat (hex)", 15, 269, 425, 14, "Left")
    layout["RawHex"] = { PrettyName = "Diagnostics~Raw Hex", Style = "Text", Position = { 15, 285 }, Size = { 425, 88 }, FontSize = 8, HTextAlign = "Left", VTextAlign = "Top", WordWrap = true }
  end
  return layout, graphics
end

function GetComponents(props) return {} end
function GetWiring(props) return {} end

--------------------------------------------------------------------------
-- Runtime
--------------------------------------------------------------------------
if Controls then
  local AMP_PORT = 45455
  local FLAG = 0xD903
  local FC_BASIC_INFO, FC_HEARTBEAT = 0, 6

  local STATE_NAMES = {
    [-1] = "Offline", [0] = "Normal", [1] = "Standby", [2] = "Fault", [3] = "Open",
    [4] = "Overload", [5] = "Clip", [6] = "DCP", [7] = "Power Error", [8] = "Run",
    [9] = "Over Temp", [10] = "Limit", [11] = "Sleep",
  }
  local FAULT_STATES = { [2] = true, [3] = true, [4] = true, [6] = true, [7] = true }

  local pollS     = Properties["Poll Interval (ms)"].Value / 1000
  local renderS   = Properties["Meter Refresh (ms)"].Value / 1000
  local atkS      = Properties["Meter Attack (ms)"].Value / 1000
  local relS      = Properties["Meter Release (ms)"].Value / 1000
  local smoothing = atkS > 0 or relS > 0
  local holdS     = Properties["Indicator Hold (ms)"].Value / 1000
  local timeoutS  = Properties["Offline Timeout (s)"].Value
  local limitGR   = Properties["Limit LED Threshold (dB GR)"].Value
  local modelProp = Properties["Amp Model"].Value
  local customV   = Properties["Custom Rated Vrms"].Value
  local listenPort = (Properties["Listen Port"].Value:find("45454") and 45454) or 0
  local debug     = Properties["Debug Print"].Value

  -- Real elapsed time (seconds). Timer.Now() is Q-SYS's monotonic clock.
  local clock = (Timer and Timer.Now) or os.clock

  local function dbg(...) if debug then print(...) end end

  ---------------------------------------------------------------- protocol
  local function checksum(inner)
    local n = #inner + 3
    local hi, lo = (n >> 8) & 0xFF, n & 0xFF
    local sum = hi + lo
    for i = 1, #inner do sum = sum + inner:byte(i) end
    return string.char(hi, lo, sum & 0xFF)
  end

  local function buildQuery(fc)
    -- struct header: 0x55, FC, status=2 (Request), chx, segment, link(i32), in/out
    local sh = string.pack("<BBBBBi4B", 0x55, fc, 2, 0, 0, 0, 0)
    local inner = sh .. checksum(sh)
    -- network header: flag, machine_mode, packets_count, lastlen, step, data_state, pad
    local nh = string.pack("<I2i2BI2BBB", FLAG, 0, 1, #inner, 1, 0, 0)
    return nh .. inner
  end

  local function validFrame(frame)
    if #frame < 13 or frame:byte(1) ~= 0x55 then return false end
    local inner = frame:sub(1, #frame - 3)
    local exp = checksum(inner)
    -- reference only compares lo + sum bytes, not hi
    return exp:byte(2) == frame:byte(#frame - 1) and exp:byte(3) == frame:byte(#frame)
  end

  local function f32(body, off) -- off = 0-based offset in body
    if off + 4 > #body then return nil end
    return (string.unpack("<f", body, off + 1))
  end
  local function u8(body, off) return body:byte(off + 1) end
  local function s8(body, off)
    local b = body:byte(off + 1); if not b then return nil end
    return b >= 128 and b - 256 or b
  end
  local function floats(body, off, n) local t = {} for i = 1, n do t[i] = f32(body, off + (i - 1) * 4) end return t end
  local function bytes(body, off, n, signed) local t = {} for i = 1, n do t[i] = signed and s8(body, off + i - 1) or u8(body, off + i - 1) end return t end

  local function looksLikeStates(body, off)
    if off + 4 > #body then return false end
    for i = 1, 4 do if body:byte(off + i) > 11 then return false end end
    return true
  end

  local VALID_LENS = { [72] = true, [76] = true, [88] = true, [92] = true, [96] = true }

  -- Returns telemetry table or nil, reason
  function ParseHeartbeatBody(body)
    local len = #body
    if not VALID_LENS[len] then return nil, "unsupported body length " .. len end
    local legacy = looksLikeStates(body, 52)
    local shifted = looksLikeStates(body, 36) and not legacy
    local t = { layout = shifted and "shifted" or "legacy", len = len }
    t.temps = floats(body, 0, 5)
    if shifted then
      t.outV = floats(body, 0, 4)
      t.outA = floats(body, 20, 4)
      t.outStates = bytes(body, 36, 4)
      t.inV = floats(body, 40, 4)
      t.gr = floats(body, 56, 4)
      t.inStates = len >= 76 and bytes(body, 72, 4, true) or {}
    else
      t.outV = floats(body, 20, 4)
      t.outA = floats(body, 36, 4)
      t.outStates = bytes(body, 52, 4)
      t.inV = floats(body, 56, 4)
      t.gr = len >= 88 and floats(body, 72, 4) or {}
      t.inStates = len >= 92 and bytes(body, 88, 4, true) or {}
    end
    t.fanV = len >= 96 and f32(body, 92) or nil
    return t
  end

  function ParseBasicInfoBody(full)
    local body = full
    if #full == 79 or #full == 87 then body = full:sub(1, #full - 4) end
    if #body < 75 then return nil end
    local function macAt(off)
      if #body < off + 6 then return nil end
      local s, parts = 0, {}
      for i = 1, 6 do local b = body:byte(off + i); s = s + b; parts[i] = string.format("%02X", b) end
      return s > 0 and table.concat(parts, ":") or nil
    end
    local macOff = macAt(72) and 72 or 64
    local mac = macAt(macOff)
    if not mac then return nil end
    local function cstr(a, b) local s = body:sub(a + 1, b); s = s:match("^([^%z]*)") or s; return (s:gsub("^%s+", ""):gsub("%s+$", "")) end
    local bi = macOff + 6
    return {
      firmware = cstr(0, 24), name = cstr(32, macOff), mac = mac,
      analogIn = body:byte(bi + 2) or 0, digitalIn = body:byte(bi + 3) or 0,
      outputs = body:byte(bi + 4) or 0, machineState = body:byte(bi + 5) or 0,
    }
  end

  function RatedVoltage(firmware)
    if modelProp == "Custom" then return customV, "Custom" end
    if modelProp ~= MODEL_CHOICES[1] then
      for _, m in ipairs(MODEL_TABLE) do if m[1] == modelProp then return m[2], m[1] end end
    end
    local up = (firmware or ""):upper()
    -- longest key first so e.g. DSP-3302 never matches a shorter key by accident
    local best
    for _, m in ipairs(MODEL_TABLE) do
      if up:find(m[1], 1, true) and (not best or #m[1] > #best[1]) then best = m end
    end
    if best then
      local dante = up:find(best[1] .. "D", 1, true) and "D" or ""
      return best[2], best[1] .. dante
    end
    return nil, nil
  end

  ---------------------------------------------------------------- state
  local sock
  local now = clock()
  local lastRx = -1e9
  local online = false
  local info = nil
  local lastInfoReq = -1e9
  local rx, tx, bad = 0, 0, 0
  local hbCount, hbWindowStart = 0, now
  local hold = {}             -- hold[name][i] = expiry time
  local active = {}           -- active[name][i] = raw bool from last heartbeat
  local FLAG_LEDS = { "InClip", "Limit", "Clip", "Fault", "TempWarn" }
  for _, n in ipairs(FLAG_LEDS) do hold[n] = {}; active[n] = {} end

  ---------------------------------------------------------------- meter ballistics
  -- invert = true would make "more negative" the attack direction (unused now
  -- that GR is shown as a positive 0..24 dB value)
  local METERS = {
    InLevel       = { floor = -60, invert = false },
    OutLevel      = { floor = -60, invert = false },
    GainReduction = { floor = 0,   invert = false },
  }
  local mTarget, mShown = {}, {}
  for n, s in pairs(METERS) do
    mTarget[n], mShown[n] = {}, {}
    for i = 1, NCH do mTarget[n][i] = s.floor; mShown[n][i] = s.floor end
  end

  local function setMeter(name, i, v)
    mTarget[name][i] = v
    if not smoothing then
      mShown[name][i] = v
      Controls[name][i].Value = v
    end
  end

  local function resetMeters()
    for n, s in pairs(METERS) do
      for i = 1, NCH do
        mTarget[n][i] = s.floor; mShown[n][i] = s.floor
        Controls[n][i].Value = s.floor
      end
    end
  end

  local renderTimer = Timer.New()
  local lastRender = clock()
  renderTimer.EventHandler = function()
    local t = clock()
    local dt = t - lastRender
    lastRender = t
    if dt <= 0 then return end
    if dt > 0.5 then dt = 0.5 end -- don't jump after a stall
    local aA = atkS > 0 and (1 - math.exp(-dt / atkS)) or 1
    local aR = relS > 0 and (1 - math.exp(-dt / relS)) or 1
    for n, s in pairs(METERS) do
      local tg, sh = mTarget[n], mShown[n]
      for i = 1, NCH do
        local cur, tgt = sh[i], tg[i]
        if cur ~= tgt then
          local rising = (tgt > cur) ~= s.invert
          local nv = cur + (tgt - cur) * (rising and aA or aR)
          if math.abs(tgt - nv) < 0.05 then nv = tgt end
          sh[i] = nv
          Controls[n][i].Value = nv
        end
      end
    end
  end

  local function ip() return (Controls.IPAddress.String or ""):gsub("%s", "") end

  local function setStatus(v, s) Controls.Status.Value = v; Controls.Status.String = s end

  local function fmt(v, f, unit) if v == nil then return "—" end return string.format(f, v) .. (unit or "") end

  local function db(v, ref)
    if v == nil or ref == nil or v <= 0 or ref <= 0 then return nil end
    return 20 * math.log(v / ref, 10)
  end

  local function setFlag(name, i, on)
    active[name][i] = on
    if on then hold[name][i] = now + holdS end
    Controls[name][i].Boolean = on or (hold[name][i] or -1) > now
  end

  local function refreshHolds()
    for _, n in ipairs(FLAG_LEDS) do
      for i = 1, NCH do
        Controls[n][i].Boolean = active[n][i] or (hold[n][i] or -1) > now
      end
    end
  end

  local function clearAll()
    resetMeters()
    for i = 1, NCH do
      for _, n in ipairs({ "InLevelText", "InVolts", "OutLevelText", "GRText", "OutVolts", "OutAmps", "OutOhms", "OutTemp", "ChState" }) do
        Controls[n][i].String = "—"
      end
      for _, n in ipairs(FLAG_LEDS) do active[n][i] = false; hold[n][i] = nil; Controls[n][i].Boolean = false end
    end
    Controls.AmpState.String = "—"; Controls.PSUTemp.String = "—"; Controls.FanVolts.String = "—"
    Controls.HBRate.String = "—"
    Controls.Online.Boolean = false
  end

  local function send(data)
    local addr = ip()
    if not sock or addr == "" then return end
    local ok, err = pcall(function() sock:Send(addr, AMP_PORT, data) end)
    if ok then tx = tx + 1 else dbg("send failed: " .. tostring(err)) end
  end

  local HB_QUERY, INFO_QUERY = buildQuery(FC_HEARTBEAT), buildQuery(FC_BASIC_INFO)

  local function toHex(s, max)
    local t = {}
    for i = 1, math.min(#s, max or 128) do t[i] = string.format("%02X", s:byte(i)) end
    return table.concat(t, " ")
  end

  ---------------------------------------------------------------- apply
  local function applyInfo(bi)
    info = bi
    local ratedV, model = RatedVoltage(bi.firmware)
    Controls.Firmware.String = bi.firmware
    Controls.DeviceName.String = bi.name ~= "" and bi.name or "—"
    Controls.MAC.String = bi.mac
    Controls.Model.String = model and (model .. string.format(" (%.1f Vrms)", ratedV)) or "Unknown — set Amp Model"
    dbg("BASIC_INFO", bi.firmware, bi.name, bi.mac, "outs=" .. bi.outputs)
  end

  local function applyHeartbeat(t, machineMode)
    local ratedV = RatedVoltage(info and info.firmware)
    local anyFault, faultText = false, nil

    for i = 1, NCH do
      -- Inputs (reference 1 V -> dBV)
      local v = t.inV[i]
      local d = db(v, 1.0)
      setMeter("InLevel", i, d and math.max(-60, math.min(20, d)) or -60)
      Controls.InLevelText[i].String = d and string.format("%.1f dBV", d) or "—"
      Controls.InVolts[i].String = fmt(v, "%.3f", " V")
      local is = t.inStates[i]
      setFlag("InClip", i, is == 0)  -- vendor InputChState: 0 = Clip, 1 = None

      -- Outputs
      local ov, oa = t.outV[i], t.outA[i]
      local od = db(ov, ratedV)
      setMeter("OutLevel", i, od and math.max(-60, math.min(3, od)) or -60)
      Controls.OutLevelText[i].String = od and string.format("%.1f dB", od) or (ratedV and "—" or "no model")
      Controls.OutVolts[i].String = fmt(ov, "%.1f")
      Controls.OutAmps[i].String = fmt(oa, "%.2f")
      Controls.OutOhms[i].String = (ov and oa and oa > 0.01) and string.format("%.0f", ov / oa) or "—"
      Controls.OutTemp[i].String = fmt(t.temps[i], "%.1f")

      local gr = t.gr[i] and math.abs(t.gr[i]) or nil
      setMeter("GainReduction", i, (gr and gr > 0) and math.min(24, gr) or 0)
      Controls.GRText[i].String = gr and string.format("GR %.1f dB", gr) or "GR —"

      local st = t.outStates[i]
      Controls.ChState[i].String = st and (STATE_NAMES[st] or ("Unknown (" .. st .. ")")) or "—"
      setFlag("Limit", i, st == 10 or (gr ~= nil and gr >= math.max(0.1, limitGR)))
      setFlag("Clip", i, st == 5)
      setFlag("Fault", i, FAULT_STATES[st] == true)
      setFlag("TempWarn", i, st == 9)
      if FAULT_STATES[st] and not anyFault then
        anyFault = true
        faultText = "Ch " .. OUT_LETTERS[i] .. " " .. STATE_NAMES[st]
      end
    end

    Controls.PSUTemp.String = fmt(t.temps[5], "%.1f", " °C")
    Controls.FanVolts.String = fmt(t.fanV, "%.1f", " V")
    Controls.AmpState.String = STATE_NAMES[machineMode] or ("Unknown (" .. tostring(machineMode) .. ")")

    -- Status
    if anyFault then setStatus(2, faultText)
    elseif FAULT_STATES[machineMode] then setStatus(2, "Amp " .. STATE_NAMES[machineMode])
    elseif not info then setStatus(5, "Online — waiting for info")
    elseif not ratedV then setStatus(1, "Unknown model — set Amp Model")
    elseif machineMode == 1 or machineMode == 11 then setStatus(0, STATE_NAMES[machineMode])
    else setStatus(0, info.name ~= "" and info.name or "OK") end

    -- Diagnostics
    Controls.BodyLength.String = tostring(t.len)
    Controls.HeartbeatLayout.String = t.layout
    Controls.RawOutStates.String = table.concat(t.outStates, " ")
    local ins = {} for i, x in ipairs(t.inStates) do ins[i] = tostring(x) end
    Controls.RawInStates.String = #ins > 0 and table.concat(ins, " ") or "(not in packet)"
    Controls.RawMachineMode.String = tostring(machineMode)
  end

  ---------------------------------------------------------------- receive
  local function onPacket(_, packet)
    local data, from = packet.Data, packet.Address
    if from ~= ip() or #data < 10 then return end
    local flag, mm, count, _, _, dstate = string.unpack("<I2i2BI2BB", data)
    if flag ~= FLAG then return end
    if dstate ~= 0 then return end      -- device ACK of one of our queries
    -- stateless ACK: echo header with data_state = 1
    send(data:sub(1, 8) .. string.char(1) .. data:sub(10, 10))
    if count > 1 then return end        -- fragmented (FC=27 etc) — not used here
    local frame = data:sub(11)
    if not validFrame(frame) then bad = bad + 1; Controls.BadFrames.String = tostring(bad); return end

    now = clock()
    rx = rx + 1
    lastRx = now
    if not online then online = true; Controls.Online.Boolean = true; dbg("amp online") end

    local fc = frame:byte(2)
    local body = frame:sub(11, #frame - 3)
    if fc == FC_HEARTBEAT then
      hbCount = hbCount + 1
      Controls.RawHex.String = toHex(body, 128)
      local t, why = ParseHeartbeatBody(body)
      if t then applyHeartbeat(t, mm)
      else
        Controls.BodyLength.String = tostring(#body) .. " (unsupported)"
        setStatus(1, why)
      end
    elseif fc == FC_BASIC_INFO then
      local bi = ParseBasicInfoBody(body)
      if bi then applyInfo(bi) end
    end
  end

  ---------------------------------------------------------------- socket
  local function closeSocket()
    if sock then pcall(function() sock:Close() end) end
    sock = nil
  end

  local function openSocket()
    closeSocket()
    sock = UdpSocket.New()
    sock.EventHandler = onPacket
    local ok = pcall(function() sock:Open(nil, listenPort) end)
    if not ok and Device and Device.LocalInterfaces then
      for _, nic in ipairs(Device.LocalInterfaces) do
        ok = pcall(function() sock:Open(nic.Address, listenPort) end)
        if ok then break end
      end
    end
    if not ok then
      setStatus(2, "Can't bind UDP " .. (listenPort == 0 and "port" or listenPort))
      closeSocket()
      return false
    end
    Controls.LocalPort.String = listenPort == 0 and "ephemeral" or tostring(listenPort)
    return true
  end

  ---------------------------------------------------------------- timer
  local timer = Timer.New()
  timer.EventHandler = function()
    now = clock()
    if not sock then return end
    send(HB_QUERY)
    -- ask for BASIC_INFO until we have it, then refresh every 30 s
    local every = info and 30 or 2
    if now - lastInfoReq >= every then lastInfoReq = now; send(INFO_QUERY) end
    if online and now - lastRx > timeoutS then
      online = false
      info = nil
      clearAll()
      setStatus(4, "No response from " .. ip())
      dbg("amp offline")
    elseif not online and now - lastRx > timeoutS then
      if Controls.Status.Value ~= 4 then setStatus(5, "Connecting to " .. ip()) end
    end
    refreshHolds()
    Controls.RxCount.String = tostring(rx)
    Controls.TxCount.String = tostring(tx)
    -- measured heartbeat replies per second, updated once a second
    local win = now - hbWindowStart
    if win >= 1 then
      Controls.HBRate.String = string.format("%.1f /s (asking %.1f /s)", hbCount / win, 1 / pollS)
      hbCount, hbWindowStart = 0, now
    end
  end

  local function stop(msg)
    timer:Stop()
    renderTimer:Stop()
    closeSocket()
    online = false; info = nil
    clearAll()
    setStatus(3, msg or "Disconnected")
  end

  local function start()
    if ip() == "" then stop("Enter IP address"); return end
    if not openSocket() then return end
    now = clock()
    online = false; info = nil; lastRx = now; lastInfoReq = -1e9
    hbCount, hbWindowStart = 0, now
    setStatus(5, "Connecting to " .. ip())
    timer:Start(pollS)
    if smoothing then
      lastRender = clock()
      renderTimer:Start(renderS)
    end
  end

  Controls.Connect.EventHandler = function(c) if c.Boolean then start() else stop() end end
  Controls.IPAddress.EventHandler = function()
    for _, n in ipairs({ "Model", "DeviceName", "Firmware", "MAC" }) do Controls[n].String = "—" end
    if Controls.Connect.Boolean then start() else stop() end
  end

  -- init
  for _, n in ipairs({ "Model", "DeviceName", "Firmware", "MAC" }) do Controls[n].String = "—" end
  Controls.BadFrames.String = "0"
  if Controls.Connect.Boolean then start() else stop() end
end
